# ===========================================
# nooshare-shell 环境变量配置
# 复制此文件为 .env 并填入真实值
# ===========================================

# RustFS / S3 配置
NOOSHARE_S3_ENDPOINT=http://your-rustfs-host:9000
NOOSHARE_S3_ACCESS_KEY=your-access-key
NOOSHARE_S3_SECRET_KEY=your-secret-key
NOOSHARE_S3_BUCKET=tong-data

# PostgreSQL 配置
NOOSHARE_PG_HOST=localhost
NOOSHARE_PG_PORT=5432
NOOSHARE_PG_DATABASE=nooshare
NOOSHARE_PG_USER=postgres
NOOSHARE_PG_PASSWORD=your-password
