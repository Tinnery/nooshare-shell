# nooshare-shell local environment
# Copy this file to .env and replace placeholders with local values.

# Shared S3-compatible storage configuration
NOOSHARE_S3_ENDPOINT=http://your-rustfs-host:9000
NOOSHARE_S3_ACCESS_KEY=your-access-key
NOOSHARE_S3_SECRET_KEY=your-secret-key
NOOSHARE_S3_BUCKET=raw
NOOSHARE_S3_REGION=us-east-1

# JQ integration input object
NOOSHARE_S3_OBJECT=meta1

# TONG source objects
NOOSHARE_TONG_HSJDAY_OBJECT=hsjday.zip
NOOSHARE_TONG_GBBQ_OBJECT=gbbq.zip

# TONG GBBQ decryption key. The hex value must decode to exactly 4176 bytes.
TONG_GZZX_KEY_HEX=

# PostgreSQL configuration
NOOSHARE_PG_HOST=localhost
NOOSHARE_PG_PORT=5432
NOOSHARE_PG_DATABASE=nooshare
NOOSHARE_PG_USER=postgres
NOOSHARE_PG_PASSWORD=your-password
