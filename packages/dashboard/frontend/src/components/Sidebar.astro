---
interface Props {
  tree?: any;
  currentPath?: string;
}

const { tree, currentPath = '' } = Astro.props;

function renderNode(node: any, depth: number = 0): string {
  if (node.type === 'directory') {
    const children = node.children?.map((c: any) => renderNode(c, depth + 1)).join('') || '';
    return `
      <div class="ml-${depth * 2}">
        <details class="group" ${currentPath.startsWith(node.path) ? 'open' : ''}>
          <summary class="flex cursor-pointer items-center gap-2 rounded px-2 py-1 text-sm font-medium text-gray-700 hover:bg-gray-100">
            <svg class="h-4 w-4 transition-transform group-open:rotate-90" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
            <svg class="h-4 w-4 text-yellow-600" fill="currentColor" viewBox="0 0 20 20">
              <path d="M2 6a2 2 0 012-2h5l2 2h5a2 2 0 012 2v6a2 2 0 01-2 2H4a2 2 0 01-2-2V6z" />
            </svg>
            <span>${node.name}</span>
          </summary>
          <div class="ml-4 mt-1 space-y-1">
            ${children}
          </div>
        </details>
      </div>
    `;
  } else if (node.type === 'file') {
    const isActive = currentPath === node.path;
    return `
      <a href="/doc/${node.path}" class="flex items-center gap-2 rounded px-2 py-1 text-sm ${isActive ? 'bg-blue-50 text-blue-700' : 'text-gray-600 hover:bg-gray-100'}">
        <svg class="h-4 w-4 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
        </svg>
        <span>${node.name}</span>
      </a>
    `;
  }
  return '';
}
---

{tree && (
  <nav class="space-y-1" set:html={renderNode(tree)} />
)}
