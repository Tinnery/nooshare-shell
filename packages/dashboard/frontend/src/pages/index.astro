---
import Base from '../layouts/Base.astro';
---

<Base title="首页">
  <fragment slot="sidebar">
    <div class="mb-4">
      <h2 class="text-lg font-semibold text-gray-900">知识库</h2>
    </div>
    <nav id="tree-nav" class="space-y-1">
      <!-- Tree will be loaded here -->
    </nav>
  </fragment>

  <!-- Hero section -->
  <div class="mb-8">
    <h1 class="text-3xl font-bold text-gray-900">NooShare 知识库</h1>
    <p class="mt-2 text-gray-600">
      浏览和管理知识库文档
    </p>
  </div>

  <!-- Stats cards -->
  <div class="mb-8 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
    <div class="rounded-lg border border-gray-200 bg-white p-6 shadow-sm">
      <div class="flex items-center gap-4">
        <div class="rounded-full bg-blue-100 p-3">
          <svg class="h-6 w-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
        </div>
        <div>
          <p class="text-sm font-medium text-gray-600">文档数量</p>
          <p id="stat-docs" class="text-2xl font-semibold text-gray-900">-</p>
        </div>
      </div>
    </div>

    <div class="rounded-lg border border-gray-200 bg-white p-6 shadow-sm">
      <div class="flex items-center gap-4">
        <div class="rounded-full bg-green-100 p-3">
          <svg class="h-6 w-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z" />
          </svg>
        </div>
        <div>
          <p class="text-sm font-medium text-gray-600">分类目录</p>
          <p id="stat-dirs" class="text-2xl font-semibold text-gray-900">-</p>
        </div>
      </div>
    </div>

    <div class="rounded-lg border border-gray-200 bg-white p-6 shadow-sm">
      <div class="flex items-center gap-4">
        <div class="rounded-full bg-purple-100 p-3">
          <svg class="h-6 w-6 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
          </svg>
        </div>
        <div>
          <p class="text-sm font-medium text-gray-600">API 状态</p>
          <p id="stat-api" class="text-2xl font-semibold text-gray-900">-</p>
        </div>
      </div>
    </div>
  </div>

  <!-- Quick access -->
  <div class="rounded-lg border border-gray-200 bg-white p-6 shadow-sm">
    <h2 class="mb-4 text-lg font-semibold text-gray-900">快速访问</h2>
    <div id="quick-access" class="space-y-2">
      <p class="text-gray-500">加载中...</p>
    </div>
  </div>

  <script>
    // Load tree and stats
    async function loadTree() {
      try {
        const res = await fetch('/api/knowledge/tree');
        const tree = await res.json();
        
        // Count files and directories
        let fileCount = 0;
        let dirCount = 0;
        
        function count(node) {
          if (node.type === 'file') {
            fileCount++;
          } else if (node.type === 'directory') {
            dirCount++;
            node.children?.forEach(count);
          }
        }
        count(tree);
        
        document.getElementById('stat-docs').textContent = fileCount;
        document.getElementById('stat-dirs').textContent = dirCount;
        
        // Render tree
        renderTree(tree, document.getElementById('tree-nav'));
        
        // Quick access - show first 5 files
        const files = [];
        function collectFiles(node) {
          if (node.type === 'file' && files.length < 5) {
            files.push(node);
          } else if (node.type === 'directory') {
            node.children?.forEach(collectFiles);
          }
        }
        collectFiles(tree);
        
        const quickAccess = document.getElementById('quick-access');
        if (files.length > 0) {
          quickAccess.innerHTML = files.map(f => `
            <a href="/doc/${f.path}" class="block rounded-lg p-3 hover:bg-gray-50">
              <div class="font-medium text-gray-900">${f.name}</div>
              <div class="text-sm text-gray-500">${f.path}</div>
            </a>
          `).join('');
        } else {
          quickAccess.innerHTML = '<p class="text-gray-500">暂无文档</p>';
        }
      } catch (err) {
        console.error('Failed to load tree:', err);
      }
    }
    
    // Check API health
    async function checkHealth() {
      try {
        const res = await fetch('/api/health');
        const data = await res.json();
        document.getElementById('stat-api').textContent = data.status === 'ok' ? '正常' : '异常';
      } catch {
        document.getElementById('stat-api').textContent = '离线';
      }
    }
    
    // Render tree navigation
    function renderTree(node, container) {
      if (node.type === 'directory') {
        const div = document.createElement('div');
        div.className = 'ml-2';
        
        if (node.name !== 'knowledge') {
          const details = document.createElement('details');
          details.className = 'group';
          
          const summary = document.createElement('summary');
          summary.className = 'flex cursor-pointer items-center gap-2 rounded px-2 py-1 text-sm font-medium text-gray-700 hover:bg-gray-100';
          summary.innerHTML = `
            <svg class="h-4 w-4 transition-transform group-open:rotate-90" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
            <svg class="h-4 w-4 text-yellow-600" fill="currentColor" viewBox="0 0 20 20">
              <path d="M2 6a2 2 0 012-2h5l2 2h5a2 2 0 012 2v6a2 2 0 01-2 2H4a2 2 0 01-2-2V6z" />
            </svg>
            <span>${node.name}</span>
          `;
          details.appendChild(summary);
          
          const content = document.createElement('div');
          content.className = 'ml-4 mt-1 space-y-1';
          node.children?.forEach(child => renderTree(child, content));
          details.appendChild(content);
          
          div.appendChild(details);
        } else {
          node.children?.forEach(child => renderTree(child, div));
        }
        
        container.appendChild(div);
      } else if (node.type === 'file') {
        const a = document.createElement('a');
        a.href = `/doc/${node.path}`;
        a.className = 'flex items-center gap-2 rounded px-2 py-1 text-sm text-gray-600 hover:bg-gray-100';
        a.innerHTML = `
          <svg class="h-4 w-4 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
          <span>${node.name}</span>
        `;
        container.appendChild(a);
      }
    }
    
    // Initialize
    loadTree();
    checkHealth();
  </script>
</Base>
